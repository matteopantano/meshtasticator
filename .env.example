# ============================================================
# Meshtastic & Shelly Automation Environment Configuration
# Copy this file to .env and fill in your private credentials.
# (.env is ignored by git and will never be committed)
# ============================================================

# --- Wi-Fi Credentials for Physical Hardware ---
# RX Gateway Node & ESP32 AP (Joins the ESP32 Hub SoftAP to bridge MQTT)
WIFI_SSID_RX="ESP32-Hub"
WIFI_PASS_RX="YourSecureWifiPass123"

# Remote TX Node (Joins your Home/Lab Wi-Fi network for Web UI access)
WIFI_SSID_TX="YourHomeWifi"
WIFI_PASS_TX="YourHomeWifiPassword"

# General / Fallback Wi-Fi
WIFI_SSID="ESP32-Hub"
WIFI_PASS="YourSecureWifiPass123"

# --- MQTT Configuration ---
MQTT_HOST_SIM="mqtt-broker"
MQTT_HOST_REAL="192.168.4.1"
MQTT_PORT="1883"

# --- Security & Cryptography ---
# Shared HMAC-SHA256 Secret (Used to authenticate command signatures)
CONTROL_SECRET="MeshShellySecret2026"

# Primary / Secondary Channel PSK (Default AQ== is standard public default)
CHANNEL_PSK="AQ=="

# --- LoRa Settings ---
# Used by provision_nodes.py (lora.region) AND baked into the ESP32 firmware
# (MESH_LORA_REGION) to build the MQTT downlink ACK topic msh/<REGION>/2/json/mqtt/.
# Keep the two in sync: the region string here MUST match the one the gateway
# node uses in its MQTT topics (e.g. EU_868, US, EU_433, ANZ ...).
# Note: meshtasticd-config/config.yaml (Docker simulated nodes) is set to US
# and is overridden by provision_nodes.py --sim with this value.
LORA_REGION="EU_868"

# --- Physical Meshtastic Gateway (RX) Node ID ---
# Hex (0x12345678) or decimal. REQUIRED for the ESP32 firmware to emit a
# routable downlink ACK (it is the "from" of the JSON downlink envelope).
# Find it with:  meshtastic --port /dev/ttyUSB0 --info   (look for !xxxxxxxx)
GATEWAY_NODE_ID="0x00000000"
