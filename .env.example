# ============================================================
# Meshtastic & Shelly Automation Environment Configuration
# Copy this file to .env and fill in your private credentials.
# (.env is ignored by git and will never be committed)
# ============================================================

# --- Wi-Fi Credentials for Physical Hardware ---
# RX Gateway Node & ESP32 AP (Joins the ESP32 Hub SoftAP to bridge MQTT)
WIFI_SSID_RX="ESP32-Hub"
WIFI_PASS_RX="YourSecureWifiPass123"

# Remote TX Node (Joins your Home/Lab Wi-Fi network for Web UI access)
WIFI_SSID_TX="YourHomeWifi"
WIFI_PASS_TX="YourHomeWifiPassword"

# General / Fallback Wi-Fi
WIFI_SSID="ESP32-Hub"
WIFI_PASS="YourSecureWifiPass123"

# --- MQTT Configuration ---
MQTT_HOST_SIM="mqtt-broker"
MQTT_HOST_REAL="192.168.4.1"
MQTT_PORT="1883"

# --- Security & Cryptography ---
# Shared HMAC-SHA256 Secret (Used to authenticate command signatures)
CONTROL_SECRET="MeshShellySecret2026"

# Primary / Secondary Channel PSK (Default AQ== is standard public default)
CHANNEL_PSK="AQ=="

# --- LoRa Settings ---
LORA_REGION="US"

# --- Optional: Physical Meshtastic Gateway Node ID (Hex e.g. 0x12345678 or Decimal) ---
# Used by ESP32 firmware for downlink ACK formatting
GATEWAY_NODE_ID="0x00000000"
