APP_TITLE=RAK4630 Remote Control
WEB_HOST=0.0.0.0
WEB_PORT=8000
LOG_LEVEL=INFO

# This file is optional when running from the repository checkout.
# The app already reuses shared values from the repository root .env
# (for example CONTROL_SECRET). Put only gateway-specific overrides here.

# Serial-connected Meshtastic device inside the Linux VM / container.
MESHTASTIC_USE_SERIAL=true
MESHTASTIC_DEVICE=/dev/ttyACM0
MESHTASTIC_HOST=localhost
MESHTASTIC_PORT=4404
MESHTASTIC_DESTINATION=^all
COMMAND_TIMEOUT_SECONDS=8
RECONNECT_INTERVAL_SECONDS=5

# Reuses the existing signed Meshtastic command implementation.
# If omitted here, these are taken from the repository root .env when present.
CONTROL_SECRET=MeshShellySecret2026
TARGET_DEVICE_ID=shelly1-sim01

# Development mode without real hardware.
MOCK_MESHTASTIC=false

# Optional: replace the default ON/OFF/TOGGLE buttons with custom command names
# that still map to the existing target/action structure.
# COMMANDS_JSON=[{"command":"OPEN_GATE","label":"Open Gate","target":"gate-relay","action":"ON","variant":"success"},{"command":"CLOSE_GATE","label":"Close Gate","target":"gate-relay","action":"OFF","variant":"danger"}]
